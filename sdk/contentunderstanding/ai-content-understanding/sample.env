# Azure AI Content Understanding Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Required Configuration
# ============================================================================

# The endpoint URL of your Microsoft Foundry resource
# Used by all samples
CONTENTUNDERSTANDING_ENDPOINT=https://your-resource.services.ai.azure.com/

# ============================================================================
# Authentication Configuration
# ============================================================================

# Option 1: API Key Authentication (optional)
# Set your API key if using key-based authentication
# If not set, DefaultAzureCredential will be used instead
CONTENTUNDERSTANDING_KEY=

# Option 2: DefaultAzureCredential (Recommended)
# If CONTENTUNDERSTANDING_KEY is not set, the SDK will use DefaultAzureCredential
# which automatically chains through available credentials in this order:
#   1. Azure PowerShell (Connect-AzAccount)
#   2. Azure CLI (az login)
#   3. Azure Developer CLI (azd auth login)
#   4. Environment variables (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# Make sure you are logged in via one of these methods before running tests.

# ============================================================================
# Test Execution Configuration
# ============================================================================

# TEST_MODE controls how tests are executed:
#   - "playback": Run tests using pre-recorded fixtures (default, no credentials needed)
#   - "record": Run tests against live Azure resources and record the responses
#   - "live": Run tests against live Azure resources without recording
TEST_MODE=playback

# ============================================================================
# Model Deployment Configuration
# ============================================================================
# Required for prebuilt analyzers (recommended models: gpt-5.2 + text-embedding-3-large).
# Also configure prebuilt aliases via updateDefaults.ts:
#   prebuilt-analyzer-completion, prebuilt-analyzer-completion-mini, prebuilt-analyzer-embedding
# Deploy these models in Microsoft Foundry and specify their deployment names here.
# Deployment names are user-defined identifiers and can differ from model names.
# Learn more: https://learn.microsoft.com/azure/ai-services/content-understanding/concepts/models-deployments

# Preferred env vars (preview guidance). Deployment values must match the names
# configured in your Microsoft Foundry resource. Only the *_DEPLOYMENT variables
# are strictly required; the model NAMES default to gpt-5.2 / text-embedding-3-large.
CU_COMPLETION_MODEL=gpt-5.2
CU_COMPLETION_MODEL_MINI=gpt-5.2
CU_COMPLETION_MODEL_DEPLOYMENT=my-completion-deployment
CU_COMPLETION_MINI_DEPLOYMENT=my-completion-mini-deployment
CU_EMBEDDING_MODEL=text-embedding-3-large
CU_EMBEDDING_DEPLOYMENT=my-embedding-deployment

# Mirrors the Python `env.sample` and `sample_update_defaults.py` shape so a
# .env authored for either language works for both.

# ============================================================================
# Optional: Local File Paths for Specific Samples
# ============================================================================
# Some samples can analyze either a bundled test asset or a local file you provide.

# Local invoice PDF whose UNIT PRICE column has multiple line items.
# Used by: createAnalyzerWorkflow.ts
CONTENTUNDERSTANDING_INVOICE_FILE=

# Local PDF or image (PNG/JPG) that contains signatures.
# Used by: detectSignatures.ts (required — the sample throws if unset)
CONTENTUNDERSTANDING_SIGNATURE_FILE=

# Local .docx file to show DOCX-specific metadata extraction.
# Used by: extractDocumentMetadata.ts (skips the DOCX section if unset)
CONTENTUNDERSTANDING_SAMPLE_DOCX=

# Optional: Override the completion model name used by advanced samples that
# construct their own ModelSelection (default: "gpt-5.2").
# Used by: analyzeChunking.ts, classifyInPageSegments.ts, createAnalyzerWorkflow.ts
CONTENTUNDERSTANDING_COMPLETION_MODEL=

# ============================================================================
# Custom Analyzer Training Configuration
# ============================================================================
# These variables are used by sample_create_analyzer_with_labels.py
# Choose Option A OR Option B below.

# --- Option A: Pre-generated SAS URL (recommended for production) ---
# Manually upload training files to a blob container, generate a SAS URL with
# Read + List permissions, and paste it here.
# Format: https://<storage-account>.blob.core.windows.net/<container>?<sas-token>
# Example: https://mystorageaccount.blob.core.windows.net/training-data?sp=rl&st=2024-01-01T00:00:00Z&se=2024-12-31T23:59:59Z&spr=https&sv=2022-11-02&sr=c&sig=...
CONTENTUNDERSTANDING_TRAINING_DATA_SAS_URL=

# --- Option B: Auto-upload (convenient for development) ---
# The sample will upload local training files and generate a User Delegation
# SAS URL via DefaultAzureCredential. Requires read/write/list on the storage account.
CONTENTUNDERSTANDING_TRAINING_DATA_STORAGE_ACCOUNT=
CONTENTUNDERSTANDING_TRAINING_DATA_CONTAINER=

# --- Common (used by both options) ---
# Optional: Prefix (folder path) to filter blobs within the container
# Example: "training_samples/" or "receipts/"
# Leave empty or omit to use the container root (all blobs at the top level)
CONTENTUNDERSTANDING_TRAINING_DATA_PREFIX=

# ============================================================================
# Cross-Subscription Copy Configuration
# ============================================================================
# These variables are used by grantCopyAuth and copyAnalyzer samples for copying analyzers
# between different Azure subscriptions or regions

# IMPORTANT: Both source and target AI Foundry Resources require 
# "Cognitive Services User" role for cross-subscription copy operations.
# Ensure your credentials have this role on both resources.

# Source Azure Resource Manager resource ID (where the analyzer currently exists)
# Required for grantCopyAuth and copyAnalyzer samples
# Format: /subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.CognitiveServices/accounts/{name}
# Example: /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/my-rg/providers/Microsoft.CognitiveServices/accounts/my-source-resource
CONTENTUNDERSTANDING_SOURCE_RESOURCE_ID=

# Source Azure region
# Required for grantCopyAuth and copyAnalyzer samples
# Example: "westus3" or "eastus"
CONTENTUNDERSTANDING_SOURCE_REGION=

# Target endpoint for cross-subscription copy
# Required for grantCopyAuth and copyAnalyzer samples
# Format: https://{resource-name}.services.ai.azure.com/
# Example: https://my-target-resource.services.ai.azure.com/
CONTENTUNDERSTANDING_TARGET_ENDPOINT=

# Target Azure Resource Manager resource ID (where you want to copy the analyzer to)
# Required for grantCopyAuth and copyAnalyzer samples
# Format: /subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.CognitiveServices/accounts/{name}
# Example: /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/my-rg/providers/Microsoft.CognitiveServices/accounts/my-target-resource
CONTENTUNDERSTANDING_TARGET_RESOURCE_ID=

# Target Azure region
# Required for grantCopyAuth and copyAnalyzer samples
# Example: "swedencentral" or "eastus"
CONTENTUNDERSTANDING_TARGET_REGION=

# Optional: Target API key if different from source
# If not set, DefaultAzureCredential will be used for target as well
CONTENTUNDERSTANDING_TARGET_KEY=

# ============================================================================
# Usage Instructions
# ============================================================================
# 1. Copy this file to .env:
#    cp sample.env .env
#
# 2. Edit .env and fill in your actual values
#
# 3. The .env file is automatically loaded by the samples and tests using dotenv
#
# 4. Make sure .env is in your .gitignore to avoid committing secrets
