# Required for all samples.
AZURE_VOICE_AGENTS_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_VOICE_AGENTS_AGENT_NAME=your-agent-name

# Optional. Defaults are shown below.
AZURE_VOICE_AGENTS_MODEL=gpt-realtime
AZURE_VOICE_AGENTS_AUDIO_INPUT_FILE=./input.pcm
AZURE_VOICE_AGENTS_AUDIO_OUTPUT_FILE=./output.pcm
