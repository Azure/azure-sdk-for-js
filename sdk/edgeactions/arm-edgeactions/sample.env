# Copy to .env in this package directory. Never commit real configuration.
# Required only for live/record mode; use an authorized test subscription.
SUBSCRIPTION_ID=
# By default each test creates an eastus resource group:
# rgjs-javascriptsdk-edgeaction-test-<suffix>
# Edge Actions use eajavascript<suffix>; both are cleaned up after the test.
# Optional: use an existing group instead. The tests will never delete that group.
# RESOURCE_GROUP=edgeaction-javascriptsdk-tests-rg
# Authenticate interactively with az login. createTestCredential supports CLI auth;
# Python's AZURE_TEST_USE_*_AUTH flags are not used by JavaScript.
# TEST_MODE: playback (no Azure calls), record (save HTTP), live (do not save).
TEST_MODE=playback