{
  "name": "default",
  "properties": {
    "policy": {
      "type": "Inventory",
      "enabled": true,
      "rules": [
        {
          "name": "inventoryPolicyRule1",
          "definition": {
            "format": "Csv",
            "objectType": "Blob",
            "schedule": "Daily",
            "schemaFields": ["Name", "Creation-Time"],
            "filters": {
              "blobTypes": ["blockBlob"]
            }
          },
          "destination": "container1",
          "enabled": true
        }
      ]
    }
  }
}
