FOUNDRY_PROJECT_ENDPOINT="<Foundry project endpoint URL>"
FOUNDRY_PROJECT_DEFAULT_ENDPOINT="<default project connection string from Microsoft Foundry>"
FOUNDRY_AGENT_CONTAINER_IMAGE="<foundry agent container image>"
FOUNDRY_MODEL_NAME="<model deployment name>"
# GPT Live is preview; its samples opt in when creating definitions and connecting.
# Use deployment names, not model catalog IDs.
FOUNDRY_LIVE_MODEL="<GPT Live deployment name>"
FOUNDRY_LIVE_BACKEND_MODEL="<Responses backend deployment name>"
# Optional raw mono PCM16LE 24 kHz input/output paths for agentVoiceLiveAudio.ts:
# FOUNDRY_LIVE_AUDIO_INPUT="<path to input.pcm>"
# FOUNDRY_LIVE_AUDIO_OUTPUT="<path to output.pcm>"
# Browser Live REST recording requires three finalized, stored Live conversations.
# Node recording creates its own fixtures; playback needs none of these variables.
# FOUNDRY_LIVE_RECORDING_AGENT_NAME="<agent owning the stored conversations>"
# FOUNDRY_LIVE_RECORDING_CONVERSATION_ID="<conversation with captured input and output audio>"
# FOUNDRY_LIVE_RECORDING_SECOND_CONVERSATION_ID="<second conversation for pagination>"
# FOUNDRY_LIVE_RECORDING_DELETE_CONVERSATION_ID="<separate conversation the tests may delete>"
# FOUNDRY_LIVE_RECORDING_INPUT_ITEM_ID="<input item in the first conversation>"
# FOUNDRY_LIVE_RECORDING_OUTPUT_ITEM_ID="<output item in the first conversation>"
FOUNDRY_AGENT_NAME="<agent name>"
# Realtime/cascaded definitions and project.voiceAgents.realtime sessions are GA.
# Inline handoff, SIP transfer destinations, and post_call require an explicit preview opt-in.
# Optional Realtime deployment for the audio, tools, and preview inline-handoff samples:
# FOUNDRY_VOICE_MODEL="gpt-realtime"
# Optional existing GA Realtime agent for audio/tools, or telephony-enabled agent for the call below:
# FOUNDRY_VOICE_AGENT_NAME="<voice agent name>"
# Optional raw mono PCM16LE 24 kHz paths for the Realtime audio/tools samples:
# FOUNDRY_VOICE_AGENT_AUDIO_INPUT_FILE="<path to input.pcm>"
# FOUNDRY_VOICE_AGENT_AUDIO_OUTPUT_FILE="<path to output.pcm>"
# Optional preview post_call destinations for agentVoice.ts; omitted by default:
# FOUNDRY_POST_CALL_EVENT_GRID_CONNECTION="<existing Event Grid connection name>"
# FOUNDRY_POST_CALL_ROUTINE_NAME="<existing routine name>"
# Read-only persisted conversation inspection; realtime is GA, live is preview.
# The session must have used store: true and completed before downloading recordings.
# FOUNDRY_VOICE_CONVERSATION_PROTOCOL="realtime"
# FOUNDRY_VOICE_CONVERSATION_ID="<stored conversation ID>"
# FOUNDRY_VOICE_CONVERSATION_ITEM_ID="<stored item ID>"
# FOUNDRY_VOICE_AUDIO_ITEM_ID="<item with captured audio; optional>"
# FOUNDRY_VOICE_RECORDING_OUTPUT_FILE="./voice-recording.wav"
# Realtime only; requires generated audio beyond the heard segment after interruption:
# FOUNDRY_VOICE_GENERATED_AUDIO_ITEM_ID="<interrupted item ID>"
# FOUNDRY_VOICE_GENERATED_AUDIO_OUTPUT_FILE="./generated-audio.wav"
# Read-only campaign inspection requires preview routes and existing fixtures.
# Call-job list/get operations are GA, including jobs created by preview campaigns:
# FOUNDRY_VOICE_CAMPAIGN_NAME="<campaign name>"
# FOUNDRY_VOICE_CAMPAIGN_OPERATION_ID="<initiating Operation-Id>"
# FOUNDRY_TELEPHONY_CALL_JOB_ID="<call-job ID>"
# agentVoiceRestWithTracing.ts only: a real outbound phone call is disabled by default.
# Requires a TPE/Twilio connection; phone-number addresses alone do not establish GA scope.
# SIP connections can also use phone numbers but are not demonstrated by this sample.
# Explicitly enabling the real call may incur charges.
# FOUNDRY_ENABLE_OUTBOUND_CALL="false"
# FOUNDRY_TELEPHONY_CONNECTION="<existing TPE/Twilio connection name>"
# FOUNDRY_TELEPHONY_SOURCE="<owned E.164 source phone number>"
# FOUNDRY_TELEPHONY_DESTINATION="<authorized E.164 test destination>"
# SKILL_PACKAGE_PATH="<path to a local skill ZIP file for the published sample>"
FOUNDRY_AGENT_BOT_SERVICE_ARM_ID="<Azure Bot Service ARM resource ID>"
MODEL_API_KEY="<model api key>"
MODEL_ENDPOINT="<model endpoint url>"
MODEL_PUBLISHER="<model publisher name>"
TELEMETRY_CONNECTION_STRING="<telemetry connection string>"

AZURE_STORAGE_CONNECTION_NAME="<storage connection name>"
MEMORY_STORE_CHAT_MODEL_DEPLOYMENT_NAME="<memory store chat model deployment name>"
MEMORY_STORE_EMBEDDING_MODEL_DEPLOYMENT_NAME="<memory store embedding model deployment name>"

AI_SEARCH_INDEX_NAME="<azure ai search index name>"
AI_SEARCH_INDEX_VERSION="<azure ai search index version>"
AI_SEARCH_CONNECTION_NAME="<azure ai search connection name>"
AI_SEARCH_CONNECTION_ID="<azure ai search project connection id>"

CONTAINER_APP_RESOURCE_ID="<container app resource id>"
CONTAINER_INGRESS_SUBDOMAIN_SUFFIX="<container app ingress subdomain suffix>"

COMPUTER_USE_MODEL_DEPLOYMENT_NAME="<computer use model deployment name>"

FABRIC_PROJECT_CONNECTION_ID="<fabric project connection id>"
SHAREPOINT_PROJECT_CONNECTION_ID="<sharepoint project connection id>"
A2A_PROJECT_CONNECTION_ID="<a2a project connection id>"

IMAGE_GENERATION_MODEL_DEPLOYMENT_NAME="<image generation model deployment name>"

MCP_PROJECT_CONNECTION_ID="<mcp project connection id>"
TRIPADVISOR_PROJECT_CONNECTION_ID="<tripadvisor project connection id>"

AZURE_AI_PROJECTS_AZURE_SUBSCRIPTION_ID="<finetuning project subscription id>"
AZURE_AI_PROJECTS_AZURE_RESOURCE_GROUP="<finetuning project resource group>"
AZURE_AI_PROJECTS_AZURE_AOAI_ACCOUNT="<finetuning project aoai account name>"

WORKIQ_CONNECTION_ID="<workiq project connection id>"
FABRIC_IQ_PROJECT_CONNECTION_ID="<fabric iq project connection id>"
