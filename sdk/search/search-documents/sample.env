# The endpoint of your Azure Search account.
ENDPOINT=<endpoint>

# The endpoint for the OpenAI service.
AZURE_OPENAI_ENDPOINT=<openai-endpoint>

# The name of the OpenAI deployment you'd like your tests to use.
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=<chat-deployment-name>
# deployment that has 'text-embedding-ada-002'
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=<embedding-deployment-name>

# Microsoft Entra application values for Work IQ knowledge source tests.
WORKIQ_APPLICATION_ID=<workiq-application-id>
WORKIQ_FEDERATED_CREDENTIAL_ID=<workiq-federated-credential-id>
# Optional; defaults to the Search service tenant when omitted.
WORKIQ_TENANT_ID=<workiq-tenant-id>
# Delegated user assertion used only for Work IQ OBO authentication.
WORK_IQ_USER_ASSERTION=<workiq-user-assertion>
# Optional, separate Search document-level authorization token.
SEARCH_QUERY_SOURCE_AUTHORIZATION=<search-query-source-authorization>

# Optional private Blob ingestion/analyzer sample prerequisites. Provision the
# required shared private links before setting these values.
AZURE_BLOB_CONNECTION_STRING=<blob-connection-string-or-resource-id>
AZURE_BLOB_CONTAINER_NAME=<blob-container-name>
AZURE_AI_SERVICES_ENDPOINT=<ai-services-endpoint>
EXPECTED_LANGUAGE_ANALYZER=<expected-microsoft-analyzer>
EXPECTED_FALLBACK_ANALYZER=<expected-fallback-analyzer>

# Optional pre-provisioned fixtures for retrieval and streaming samples.
KNOWLEDGE_BASE_NAME=<existing-knowledge-base-name>
CITATION_KNOWLEDGE_BASE_NAME=<six-kind-citation-knowledge-base-name>

# Optional data source/indexer operation samples.
CONNECTION_STRING=<data-source-connection-string>
DATA_SOURCE_NAME=<data-source-name>
TARGET_INDEX_NAME=<target-index-name>

# Optional MCP sample.
MCP_SERVER_URL=<mcp-server-url>
MCP_API_KEY=<mcp-api-key>

# Optional Fabric live samples.
FABRIC_WORKSPACE_ID=<fabric-workspace-id>
FABRIC_DATA_AGENT_ID=<fabric-data-agent-id>
FABRIC_ONTOLOGY_ID=<fabric-ontology-id>

# Our tests assume that TEST_MODE is "playback" by default. You can
# change it to "record" to generate new recordings, or "live" to bypass the recorder entirely.
# TEST_MODE=playback
