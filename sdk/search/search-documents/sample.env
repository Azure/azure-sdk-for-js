# The endpoint of your Azure Search account.
ENDPOINT=<endpoint>
# Optional Search admin API key for the self-contained November feature samples.
# Otherwise they use DefaultAzureCredential.
AZURE_SEARCH_API_KEY=<search-admin-api-key>

# The endpoint for the OpenAI service.
AZURE_OPENAI_ENDPOINT=<openai-endpoint>
# Optional alternative to the Search service's managed identity for model calls.
AZURE_OPENAI_API_KEY=<openai-api-key>

# The name of the OpenAI deployment you'd like your tests to use.
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=<chat-deployment-name>
# Optional underlying chat model; independent of the deployment name.
# Defaults are sample-specific: gpt-4o for query hints, gpt-5.4-mini for preview configuration.
AZURE_OPENAI_CHAT_MODEL_NAME=<chat-model-name>
# deployment that has 'text-embedding-ada-002'
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=<embedding-deployment-name>
# Optional underlying embedding model; independent of the deployment name.
AZURE_OPENAI_EMBEDDING_MODEL_NAME=text-embedding-ada-002
# topicGraphDiverseSearch uses these same embedding settings and 1536 dimensions.
# It supports ada-002, 3-small, and 3-large; no chat deployment or shared dataset
# is needed. The caller and Search managed identity need OpenAI embedding access,
# or set AZURE_OPENAI_API_KEY for both callers. Semantic ranker must be enabled.
# agenticSearch additionally requires standard (paid) Knowledge Retrieval; MR1 has no free tier.

# Microsoft Entra application values for Work IQ knowledge source tests.
WORKIQ_APPLICATION_ID=<workiq-application-id>
WORKIQ_FEDERATED_CREDENTIAL_ID=<workiq-federated-credential-id>
# Optional; defaults to the Search service tenant when omitted.
WORKIQ_TENANT_ID=<workiq-tenant-id>
# Delegated user assertion used only for Work IQ OBO authentication.
WORK_IQ_USER_ASSERTION=<workiq-user-assertion>
# Optional, separate Search document-level authorization token.
SEARCH_QUERY_SOURCE_AUTHORIZATION=<search-query-source-authorization>

# Optional private Blob ingestion/analyzer sample prerequisites. Provision the
# required shared private links before setting these values.
AZURE_BLOB_CONNECTION_STRING=<blob-connection-string-or-resource-id>
AZURE_BLOB_CONTAINER_NAME=<blob-container-name>
AZURE_AI_SERVICES_ENDPOINT=<ai-services-endpoint>
EXPECTED_LANGUAGE_ANALYZER=<expected-microsoft-analyzer>
EXPECTED_FALLBACK_ANALYZER=<expected-fallback-analyzer>

# Optional pre-provisioned fixtures for retrieval and streaming samples.
KNOWLEDGE_BASE_NAME=<existing-knowledge-base-name>
CITATION_KNOWLEDGE_BASE_NAME=<six-kind-citation-knowledge-base-name>

# November sample: existing edge-list graph index and a schema-specific,
# constrained query. For example, with Person/Topic labels and a studied edge:
# GRAPH_QUERY=MATCH (s:Person)-[r:studied]->(o:Topic) RETURN s, r, o LIMIT 5
GRAPH_INDEX_NAME=<graph-index-name>
GRAPH_QUERY=<constrained-graph-query>
# Existing index with a text vectorizer and a populated topic-graph profile
# on contentVector. The KB's search-index source must also support topic graphs.
INDEX_NAME=<topic-graph-index-name>
KNOWLEDGE_BASE_TOOL_NAME=<existing-tool-name>
KNOWLEDGE_SOURCE_NAME=<existing-search-index-source-name>
FILE_KNOWLEDGE_SOURCE_NAME=<existing-file-source-name>

# Optional data source/indexer operation samples.
CONNECTION_STRING=<data-source-connection-string>
DATA_SOURCE_NAME=<data-source-name>
TARGET_INDEX_NAME=<target-index-name>

# Optional MCP sample.
MCP_SERVER_URL=<mcp-server-url>
MCP_API_KEY=<mcp-api-key>

# Optional Fabric live samples.
FABRIC_WORKSPACE_ID=<fabric-workspace-id>
FABRIC_DATA_AGENT_ID=<fabric-data-agent-id>
FABRIC_ONTOLOGY_ID=<fabric-ontology-id>

# knowledgeSourceOneLakeSecurity: a small preconfigured ACL fixture. User tokens
# are separate from Search admin credentials. The denied user must have no read
# access to any document in the selected folder; neither run enables elevated read.
ONELAKE_LAKEHOUSE_ID=<lakehouse-id>
ONELAKE_TARGET_PATH=<small-fixture-folder>
ONELAKE_ALLOWED_USER_TOKEN=<allowed-user-token>
ONELAKE_DENIED_USER_TOKEN=<denied-user-token>
ONELAKE_TEST_QUERY=<query-identifying-the-fixture-document>

# knowledgeSourceGraphExtraction: upload samples-dev/fixtures/hotelGraph.txt to an
# approved nonempty folder with content type text/plain; configure native Blob soft delete first.
# This sample removes owned generated Search resources but leaves source/cache storage intact.
AZURE_BLOB_FOLDER_PATH=<small-hotel-relationships-folder>
AZURE_GRAPH_CACHE_CONNECTION_STRING=<existing-cache-storage-connection-string>
GRAPH_RETRIEVAL_QUERY=Using the knowledge graph, which organizations operate the hotels?

# queryHintsAutoConfiguration: optionally add a new country and retrieve after the 60-second TTL.
QUERY_HINT_REFRESH=false

# Native GPT-6 recorded sample tests can use a separate deployment from other chat scenarios.
AZURE_OPENAI_GPT6_DEPLOYMENT_NAME=<gpt6-deployment-name>
AZURE_OPENAI_GPT6_MODEL_NAME=gpt-6-sol

# knowledgeBaseModelProviders: azureOpenAI selects a deployed GPT-6 chat model
# using the native settings above. openAICompatible selects the complete gateway
# URIs below. GPT-6 chat profiles require Responses with stateless continuation.
KNOWLEDGE_MODEL_PROVIDER=<azureOpenAI-or-openAICompatible>
OPENAI_COMPATIBLE_CHAT_URI=<complete-https-chat-or-responses-post-url>
OPENAI_COMPATIBLE_CHAT_MODEL_NAME=<supported-chat-model-profile>
OPENAI_COMPATIBLE_EMBEDDINGS_URI=<complete-https-embeddings-post-url>
OPENAI_COMPATIBLE_EMBEDDING_MODEL_NAME=<supported-text-embedding-model>
OPENAI_COMPATIBLE_EMBEDDING_DIMENSIONS=1536
OPENAI_COMPATIBLE_AUTH_HEADER=api-key
OPENAI_COMPATIBLE_API_KEY=<gateway-api-key>

# Our tests assume that TEST_MODE is "playback" by default. You can
# change it to "record" to generate new recordings, or "live" to bypass the recorder entirely.
# TEST_MODE=playback
