# Azure Web PubSub Chat service endpoint
WPS_CHAT_ENDPOINT=

# Connection string (alternative to endpoint + credential)
WPS_CHAT_CONNECTION_STRING=

# Hub name
WPS_CHAT_HUB=

# Samples use these variables (tests use WPS_CHAT_ENDPOINT and the test_hub hub).
WEB_PUB_SUB_CHAT_SERVICE_ENDPOINT=
WEB_PUB_SUB_CHAT_HUB=

# Existing resources for atomic topic and membership-list samples.
WEB_PUB_SUB_CHAT_ROOM_ID=general
WEB_PUB_SUB_CHAT_USER_ID=alice
WEB_PUB_SUB_CHAT_TOPIC_ID=announcements
